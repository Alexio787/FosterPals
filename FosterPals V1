<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>FosterPaws — Foster Management for Modern Rescue Organizations</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"/>

<style>
/* ── RESET & BASE ─────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: #050F08;
  color: #F0F7F2;
  font-family: 'Outfit', sans-serif;
  overflow-x: hidden;
  cursor: none;
}

/* ── CUSTOM CURSOR ────────────────────────────────────── */
.cursor {
  width: 12px; height: 12px;
  background: #D4A017;
  border-radius: 50%;
  position: fixed; top: 0; left: 0;
  pointer-events: none; z-index: 9999;
  transform: translate(-50%, -50%);
  transition: transform 0.1s ease, width 0.2s ease, height 0.2s ease, opacity 0.2s ease;
  mix-blend-mode: normal;
}
.cursor-ring {
  width: 36px; height: 36px;
  border: 1.5px solid #D4A01788;
  border-radius: 50%;
  position: fixed; top: 0; left: 0;
  pointer-events: none; z-index: 9998;
  transform: translate(-50%, -50%);
  transition: transform 0.18s ease, width 0.25s ease, height 0.25s ease;
}
body:hover .cursor { opacity: 1; }
a:hover ~ .cursor, button:hover ~ .cursor { width: 20px; height: 20px; }

/* ── CSS VARIABLES ────────────────────────────────────── */
:root {
  --g950: #020A04;
  --g900: #050F08;
  --g800: #0A2118;
  --g700: #0F3322;
  --g600: #1A5235;
  --g500: #237A4A;
  --g400: #2E9A5C;
  --g300: #52C27C;
  --g200: #90DBA8;
  --g100: #C8F0D6;
  --g50:  #EDFBF3;
  --au900: #3D2700;
  --au800: #6B4400;
  --au700: #9A6500;
  --au600: #C98A00;
  --au500: #D4A017;
  --au400: #E8B830;
  --au300: #F5CC50;
  --au200: #FAE080;
  --au100: #FFF4C2;
  --white: #FFFFFF;
  --off:   #F4FBF6;
  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans:  'Outfit', sans-serif;
  --mono:  'JetBrains Mono', monospace;
  --shadow-gold: 0 8px 40px rgba(212,160,23,0.35);
  --shadow-deep: 0 20px 80px rgba(0,0,0,0.6);
}

/* ── TYPOGRAPHY ───────────────────────────────────────── */
.serif { font-family: var(--serif); }
.mono  { font-family: var(--mono); }

/* ── NOISE TEXTURE OVERLAY ────────────────────────────── */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none; z-index: 1000; opacity: 0.35;
}

/* ── NAV ──────────────────────────────────────────────── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 500;
  padding: 20px 48px;
  display: flex; align-items: center; justify-content: space-between;
  transition: all 0.4s ease;
}
nav.scrolled {
  background: rgba(5,15,8,0.92);
  backdrop-filter: blur(24px);
  border-bottom: 1px solid rgba(212,160,23,0.15);
  padding: 14px 48px;
}
.nav-logo {
  display: flex; align-items: center; gap: 12px;
  text-decoration: none;
}
.nav-logo-icon {
  width: 38px; height: 38px; border-radius: 10px;
  background: linear-gradient(135deg, var(--au600), var(--au400));
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  box-shadow: var(--shadow-gold);
}
.nav-logo-text {
  font-family: var(--sans); font-size: 16px; font-weight: 800;
  color: var(--white); letter-spacing: 0.08em;
}
.nav-links {
  display: flex; align-items: center; gap: 36px;
  list-style: none;
}
.nav-links a {
  color: var(--g200); font-size: 14px; font-weight: 500;
  text-decoration: none; letter-spacing: 0.02em;
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--au400); }
.nav-cta {
  background: linear-gradient(135deg, var(--au600), var(--au400));
  color: var(--g900) !important; font-weight: 700 !important;
  padding: 10px 22px; border-radius: 30px;
  box-shadow: 0 4px 20px rgba(212,160,23,0.4);
  transition: all 0.25s ease !important;
}
.nav-cta:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 28px rgba(212,160,23,0.55) !important;
  color: var(--g900) !important;
}

/* ── GOLD SHIMMER BAR ─────────────────────────────────── */
.gold-bar {
  height: 3px; border-radius: 2px;
  background: linear-gradient(90deg, transparent, var(--au700) 20%, var(--au400) 50%, var(--au200) 65%, var(--au400) 80%, transparent);
  background-size: 200% 100%;
  animation: shimmerSlide 3s linear infinite;
}

/* ── HERO ─────────────────────────────────────────────── */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center;
  padding: 120px 24px 80px;
  position: relative; overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0; z-index: 0;
  background: radial-gradient(ellipse 80% 60% at 50% 40%, var(--g700) 0%, var(--g800) 40%, var(--g900) 80%);
}
.hero-orb-1 {
  position: absolute; top: -20%; right: -10%;
  width: 600px; height: 600px; border-radius: 50%;
  background: radial-gradient(circle, rgba(212,160,23,0.12) 0%, transparent 65%);
  animation: orbFloat 12s ease-in-out infinite;
}
.hero-orb-2 {
  position: absolute; bottom: -15%; left: -8%;
  width: 500px; height: 500px; border-radius: 50%;
  background: radial-gradient(circle, rgba(46,154,92,0.15) 0%, transparent 65%);
  animation: orbFloat 15s ease-in-out infinite reverse;
}
.hero-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(212,160,23,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(212,160,23,0.04) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 0%, transparent 100%);
}
.hero-ring {
  position: absolute; border-radius: 50%;
  border: 1px solid rgba(212,160,23,0.12);
  animation: ringPulse 6s ease-in-out infinite;
}
.hero-content { position: relative; z-index: 2; max-width: 860px; }
.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(212,160,23,0.12);
  border: 1px solid rgba(212,160,23,0.3);
  border-radius: 30px; padding: 8px 18px; margin-bottom: 32px;
  font-size: 12px; font-weight: 700; letter-spacing: 0.1em;
  color: var(--au400);
  animation: fadeUp 0.6s 0.1s both;
}
.hero-badge::before {
  content: ''; width: 7px; height: 7px; border-radius: 50%;
  background: var(--au400);
  box-shadow: 0 0 8px var(--au400);
  animation: badgePulse 2s infinite;
}
.hero-h1 {
  font-family: var(--serif);
  font-size: clamp(48px, 7vw, 88px);
  font-weight: 700; line-height: 1.04; letter-spacing: -0.03em;
  color: var(--white); margin-bottom: 12px;
  animation: fadeUp 0.7s 0.2s both;
}
.hero-h1 em {
  font-style: italic;
  background: linear-gradient(120deg, var(--au500), var(--au300), var(--au500));
  background-size: 200% 100%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmerSlide 4s linear infinite;
  filter: drop-shadow(0 0 30px rgba(212,160,23,0.4));
}
.hero-sub {
  font-size: 18px; font-weight: 400; color: var(--g200);
  line-height: 1.7; max-width: 560px; margin: 0 auto 48px;
  animation: fadeUp 0.7s 0.35s both;
}
.hero-ctas {
  display: flex; align-items: center; justify-content: center;
  gap: 16px; flex-wrap: wrap;
  animation: fadeUp 0.7s 0.5s both;
}
.btn-primary {
  display: inline-flex; align-items: center; gap: 10px;
  background: linear-gradient(120deg, var(--au700), var(--au500), var(--au300), var(--au500));
  background-size: 250% 100%;
  color: var(--g900); font-weight: 800; font-size: 16px;
  padding: 16px 32px; border-radius: 50px; border: none;
  text-decoration: none; cursor: none;
  box-shadow: 0 8px 40px rgba(212,160,23,0.45);
  animation: ctaShimmer 3s linear infinite;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.btn-primary:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 16px 56px rgba(212,160,23,0.65);
}
.btn-secondary {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.06);
  border: 1.5px solid rgba(255,255,255,0.15);
  color: var(--white); font-weight: 600; font-size: 16px;
  padding: 15px 30px; border-radius: 50px;
  text-decoration: none; cursor: none;
  backdrop-filter: blur(10px);
  transition: all 0.25s ease;
}
.btn-secondary:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(212,160,23,0.4);
  transform: translateY(-2px);
}
.hero-social {
  display: flex; align-items: center; gap: 24px;
  margin-top: 60px;
  animation: fadeUp 0.7s 0.65s both;
}
.hero-social-label {
  font-size: 12px; color: var(--g400); font-weight: 600;
  letter-spacing: 0.06em;
}
.hero-avatars {
  display: flex; align-items: center;
}
.hero-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  border: 2px solid var(--g800);
  margin-left: -10px; font-size: 18px;
  background: var(--g700);
  display: flex; align-items: center; justify-content: center;
}
.hero-avatar:first-child { margin-left: 0; }
.hero-stat {
  font-family: var(--mono); font-size: 13px; color: var(--au400); font-weight: 600;
}

/* ── LOGO STRIP ───────────────────────────────────────── */
.logo-strip {
  padding: 40px 0;
  border-top: 1px solid rgba(212,160,23,0.1);
  border-bottom: 1px solid rgba(212,160,23,0.1);
  overflow: hidden; position: relative;
  background: rgba(10,33,24,0.6);
}
.logo-strip::before, .logo-strip::after {
  content: ''; position: absolute; top: 0; bottom: 0; width: 120px; z-index: 2;
}
.logo-strip::before { left: 0; background: linear-gradient(90deg, #050F08, transparent); }
.logo-strip::after  { right: 0; background: linear-gradient(-90deg, #050F08, transparent); }
.logo-track {
  display: flex; gap: 80px; align-items: center;
  animation: scrollTrack 30s linear infinite;
  white-space: nowrap; width: max-content;
}
.logo-item {
  font-family: var(--serif); font-size: 18px; font-weight: 600;
  color: var(--g400); letter-spacing: 0.05em; opacity: 0.7;
  display: flex; align-items: center; gap: 10px;
}
.logo-item span { font-size: 22px; }

/* ── SECTION BASE ─────────────────────────────────────── */
section { padding: 100px 24px; }
.section-inner { max-width: 1100px; margin: 0 auto; }
.section-label {
  font-size: 11px; font-weight: 800; letter-spacing: 0.18em;
  color: var(--au500); text-transform: uppercase; margin-bottom: 16px;
  display: flex; align-items: center; gap: 12px;
}
.section-label::before {
  content: ''; width: 30px; height: 2px;
  background: linear-gradient(90deg, var(--au500), var(--au300));
}
.section-h2 {
  font-family: var(--serif);
  font-size: clamp(36px, 5vw, 58px);
  font-weight: 700; line-height: 1.1; letter-spacing: -0.025em;
  color: var(--white); margin-bottom: 20px;
}
.section-h2 em {
  font-style: italic; color: var(--au400);
}
.section-sub {
  font-size: 17px; color: var(--g200); line-height: 1.75;
  max-width: 560px;
}

/* ── FEATURES ─────────────────────────────────────────── */
.features { background: var(--g900); }
.features-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 2px; margin-top: 64px;
  border: 2px solid rgba(212,160,23,0.12);
  border-radius: 24px; overflow: hidden;
}
.feature-card {
  background: var(--g800);
  padding: 40px 36px;
  position: relative; overflow: hidden;
  transition: background 0.3s ease;
}
.feature-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--au500), transparent);
  opacity: 0; transition: opacity 0.3s;
}
.feature-card:hover { background: var(--g700); }
.feature-card:hover::before { opacity: 1; }
.feature-icon {
  width: 52px; height: 52px; border-radius: 14px;
  background: linear-gradient(135deg, rgba(212,160,23,0.15), rgba(212,160,23,0.05));
  border: 1px solid rgba(212,160,23,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; margin-bottom: 24px;
  transition: all 0.3s ease;
}
.feature-card:hover .feature-icon {
  background: linear-gradient(135deg, var(--au600), var(--au400));
  box-shadow: var(--shadow-gold);
  transform: scale(1.08);
}
.feature-h3 {
  font-family: var(--serif); font-size: 22px; font-weight: 700;
  color: var(--white); margin-bottom: 12px; letter-spacing: -0.01em;
}
.feature-p {
  font-size: 14px; color: var(--g200); line-height: 1.75; font-weight: 400;
}
.feature-glow {
  position: absolute; bottom: -40px; right: -40px;
  width: 120px; height: 120px; border-radius: 50%;
  background: radial-gradient(circle, rgba(212,160,23,0.08), transparent 70%);
  transition: opacity 0.3s;
}
.feature-card:hover .feature-glow { opacity: 2; }

/* ── STATS BAND ───────────────────────────────────────── */
.stats-band {
  background: linear-gradient(135deg, var(--g800), var(--g700));
  border-top: 1px solid rgba(212,160,23,0.15);
  border-bottom: 1px solid rgba(212,160,23,0.15);
  padding: 64px 24px;
}
.stats-grid {
  max-width: 900px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
}
.stat-item {
  text-align: center; padding: 20px;
  border-right: 1px solid rgba(212,160,23,0.12);
}
.stat-item:last-child { border-right: none; }
.stat-n {
  font-family: var(--serif); font-size: 52px; font-weight: 700;
  background: linear-gradient(160deg, var(--au300), var(--au500));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; line-height: 1;
  filter: drop-shadow(0 0 20px rgba(212,160,23,0.35));
}
.stat-label {
  font-size: 13px; color: var(--g300); font-weight: 500;
  margin-top: 8px; letter-spacing: 0.03em;
}

/* ── PRICING ──────────────────────────────────────────── */
.pricing { background: var(--g950); position: relative; overflow: hidden; }
.pricing::before {
  content: ''; position: absolute; top: -200px; left: 50%;
  transform: translateX(-50%);
  width: 800px; height: 800px; border-radius: 50%;
  background: radial-gradient(circle, rgba(212,160,23,0.06) 0%, transparent 65%);
  pointer-events: none;
}
.pricing-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 24px; margin-top: 64px; align-items: start;
}
.plan-card {
  background: var(--g800);
  border: 1.5px solid rgba(255,255,255,0.07);
  border-radius: 24px; padding: 40px 36px;
  position: relative; overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.plan-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 60px rgba(0,0,0,0.4);
}
.plan-card.featured {
  background: linear-gradient(160deg, var(--g700), var(--g800));
  border: 1.5px solid rgba(212,160,23,0.45);
  box-shadow: 0 0 0 1px rgba(212,160,23,0.15), 0 20px 60px rgba(0,0,0,0.5);
  transform: scale(1.04);
}
.plan-card.featured:hover { transform: scale(1.04) translateY(-6px); }
.plan-badge {
  position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  background: linear-gradient(90deg, var(--au700), var(--au400));
  color: var(--g900); font-size: 10px; font-weight: 800;
  letter-spacing: 0.12em; padding: 6px 20px;
  border-radius: 0 0 16px 16px;
  white-space: nowrap;
}
.plan-name {
  font-family: var(--serif); font-size: 28px; font-weight: 700;
  color: var(--white); margin-bottom: 6px; letter-spacing: -0.01em;
}
.plan-desc {
  font-size: 13px; color: var(--g300); margin-bottom: 32px;
  line-height: 1.5;
}
.plan-price {
  display: flex; align-items: flex-end; gap: 4px; margin-bottom: 8px;
}
.plan-dollar {
  font-family: var(--serif); font-size: 28px; font-weight: 700;
  color: var(--au400); line-height: 1.2;
}
.plan-amount {
  font-family: var(--serif); font-size: 64px; font-weight: 700;
  line-height: 1; letter-spacing: -0.04em;
  background: linear-gradient(160deg, var(--au300), var(--au500));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.plan-period {
  font-size: 14px; color: var(--g400); margin-bottom: 10px; font-weight: 500;
}
.plan-annual {
  display: inline-block;
  font-size: 11px; color: var(--g300); font-weight: 600;
  background: rgba(46,154,92,0.15);
  border: 1px solid rgba(46,154,92,0.25);
  border-radius: 20px; padding: 4px 10px; margin-bottom: 32px;
}
.plan-divider {
  height: 1px; background: rgba(255,255,255,0.07); margin-bottom: 28px;
}
.plan-features { list-style: none; margin-bottom: 36px; }
.plan-feature {
  display: flex; align-items: flex-start; gap: 12px;
  font-size: 14px; color: var(--g100); font-weight: 400;
  padding: 8px 0; line-height: 1.4;
}
.plan-feature-icon {
  width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; margin-top: 1px;
}
.plan-feature-icon.check {
  background: rgba(46,154,92,0.2);
  border: 1px solid rgba(46,154,92,0.4);
  color: var(--g300);
}
.plan-feature-icon.check-gold {
  background: rgba(212,160,23,0.2);
  border: 1px solid rgba(212,160,23,0.4);
  color: var(--au400);
}
.plan-btn {
  display: block; width: 100%; padding: 15px;
  border-radius: 14px; border: none;
  font-family: var(--sans); font-size: 15px; font-weight: 700;
  text-align: center; text-decoration: none;
  cursor: none; transition: all 0.25s ease;
}
.plan-btn.outline {
  background: transparent;
  border: 1.5px solid rgba(255,255,255,0.15);
  color: var(--white);
}
.plan-btn.outline:hover {
  border-color: rgba(212,160,23,0.5);
  background: rgba(212,160,23,0.08);
  transform: translateY(-2px);
}
.plan-btn.gold {
  background: linear-gradient(120deg, var(--au700), var(--au500), var(--au300));
  background-size: 200% 100%;
  color: var(--g900);
  box-shadow: var(--shadow-gold);
  animation: ctaShimmer 3s linear infinite;
}
.plan-btn.gold:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(212,160,23,0.55);
}
.plan-card-glow {
  position: absolute; bottom: -60px; right: -60px;
  width: 180px; height: 180px; border-radius: 50%;
  background: radial-gradient(circle, rgba(212,160,23,0.07), transparent 70%);
  pointer-events: none;
}

/* ── FAQ ──────────────────────────────────────────────── */
.faq { background: var(--g900); }
.faq-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 20px; margin-top: 64px;
}
.faq-item {
  background: var(--g800);
  border: 1.5px solid rgba(255,255,255,0.07);
  border-radius: 18px; padding: 28px 32px;
  cursor: none; position: relative; overflow: hidden;
  transition: all 0.3s ease;
}
.faq-item::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg, var(--au500), var(--au300));
  opacity: 0; transition: opacity 0.3s;
}
.faq-item:hover { border-color: rgba(212,160,23,0.25); background: var(--g700); }
.faq-item:hover::before { opacity: 1; }
.faq-q {
  font-family: var(--serif); font-size: 19px; font-weight: 700;
  color: var(--white); margin-bottom: 12px; letter-spacing: -0.01em;
}
.faq-a {
  font-size: 14px; color: var(--g200); line-height: 1.75;
}

/* ── TESTIMONIALS ─────────────────────────────────────── */
.testimonials { background: var(--g800); overflow: hidden; }
.testimonials-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 20px; margin-top: 64px;
}
.testimonial-card {
  background: var(--g900);
  border: 1.5px solid rgba(212,160,23,0.1);
  border-radius: 20px; padding: 32px;
  position: relative; overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.testimonial-card:hover {
